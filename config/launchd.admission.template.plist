<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.craft-protocol.recovery-admission</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/.craft-agent/scripts/recovery-admission-cron.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CRAFT_ADMISSION_CLI_TIMEOUT_SECONDS</key>
    <string>110</string>
    <key>CRAFT_ADMISSION_SUPERVISOR_TIMEOUT_SECONDS</key>
    <string>120</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.craft-agent/logs/recovery-admission.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.craft-agent/logs/recovery-admission.stderr.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
