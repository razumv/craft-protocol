{
  "version": 2,
  "automations": {
    "SchedulerTick": [
      {
        "id": "a321-notifier",
        "name": "Protocol v3.2.1 admitted recovery notifier",
        "enabled": false,
        "cron": "0 0 1 1 *",
        "timezone": "UTC",
        "permissionMode": "allow-all",
        "labels": [
          "auto",
          "agent-role::recovery-notifier",
          "work-unit::self-healing-v3.2.1-notifier",
          "protocol-version::3.2.1"
        ],
        "actions": [
          {
            "type": "prompt",
            "llmConnection": "chatgpt-plus",
            "model": "pi/gpt-5.4-mini",
            "prompt": "DISABLED TEMPLATE. recovery-admission.py replaces this prompt only after deterministic pre-session admission."
          }
        ]
      },
      {
        "id": "a31101",
        "name": "Legacy recurring recovery sweep (permanently disabled)",
        "enabled": false,
        "cron": "*/15 * * * *",
        "timezone": "Europe/Warsaw",
        "permissionMode": "allow-all",
        "labels": [
          "auto",
          "agent-role::recovery-controller",
          "work-unit::self-healing-v3.2.1-legacy",
          "protocol-version::3.2.1"
        ],
        "actions": [
          {
            "type": "prompt",
            "llmConnection": "chatgpt-plus",
            "model": "pi/gpt-5.6-sol",
            "prompt": "PERMANENTLY DISABLED: recurring PromptAction creates a session before admission."
          }
        ]
      }
    ],
    "SessionStatusChange": [
      {
        "id": "a31102",
        "name": "Protocol v3.2.1 terminal handoff recovery (disabled; scheduler owns recovery)",
        "enabled": false,
        "matcher": "^needs-review$",
        "permissionMode": "allow-all",
        "conditions": [
          {
            "condition": "or",
            "conditions": [
              { "condition": "state", "field": "labels", "contains": "agent-role::worker" },
              { "condition": "state", "field": "labels", "contains": "agent-role::auditor" }
            ]
          }
        ],
        "labels": [
          "auto",
          "agent-role::recovery-controller",
          "work-unit::self-healing-v3.2.1",
          "protocol-version::3.2.1"
        ],
        "actions": [
          {
            "type": "prompt",
            "llmConnection": "chatgpt-plus",
            "model": "pi/gpt-5.6-sol",
            "prompt": "[skill:self-healing-controller] Reconcile the exact terminal handoff for triggering session $CRAFT_SESSION_ID ($CRAFT_SESSION_NAME), event $CRAFT_EVENT_DATA. Acquire the controller lease and apply only preservation-proven archive/reap and coordinator slot-release rules. If evidence is incomplete, defer/escalate without cleanup. Release the lease, set needs-review, and stop."
          }
        ]
      }
    ]
  }
}
